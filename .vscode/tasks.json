{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Servidor do site (porta 5500)",
      "type": "shell",
      "command": "python3 -m http.server 5500 --bind 127.0.0.1",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Gerar versao do Artifact",
      "type": "shell",
      "command": "python3 tools/build-artifact.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
